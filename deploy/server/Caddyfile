{$PUBLIC_HOST} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @unleash path /unleash /unleash/*
    handle @unleash {
        reverse_proxy {$UNLEASH_UPSTREAM:application:5056}
    }
    handle {
        reverse_proxy application:5056
    }
}
