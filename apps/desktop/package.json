{
  "name": "home-theater-desktop",
  "version": "0.5.0-rc.6",
  "private": true,
  "desktopName": "home_theater.desktop",
  "description": "home_theater desktop media host",
  "author": "home_theater contributors",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.hometheater.desktop",
    "productName": "home_theater",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "home_theater-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "syncDesktopName": true
    },
    "asarUnpack": [
      "node_modules/node-datachannel/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "icon": "src/icon.png"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "parse-torrent": "11.0.24",
    "webtorrent": "3.0.21"
  }
}
