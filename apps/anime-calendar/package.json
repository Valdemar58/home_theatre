{
  "name": "anime-calendar",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node database/prepare.mjs && next dev -p 5056",
    "build": "next build --webpack",
    "start": "node database/prepare.mjs && next start -p 5056",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node database/migrate.mjs up",
    "db:rollback": "node database/migrate.mjs down",
    "db:import-sqlite": "node database/import-sqlite.mjs",
    "db:backup": "node database/backup.mjs",
    "db:create-migration": "node-pg-migrate create --migration-file-language sql --migrations-dir migrations"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.108.3",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "hls.js": "1.7.4",
    "htmlparser2": "^10.1.0",
    "iron-session": "^9.1.0",
    "jassub": "1.8.8",
    "next": "^16.4.6",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sigma": "^3.0.3",
    "synckit": "^0.12.3",
    "unleash-client": "6.12.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1",
    "glob": "14.0.2"
  }
}
