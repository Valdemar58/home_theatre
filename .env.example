# ============================================================
#  Скопируй в .env (это делает `python scripts/init.py`) и поправь.
#  Пустые *_API_KEY init.py заполнит случайными значениями.
# ============================================================

# --- Docker Compose ---
# Какие файлы подключать. Без GPU: docker-compose.yml
# NVIDIA: docker-compose.yml:compose.nvidia.yml   Intel iGPU: docker-compose.yml:compose.intel.yml
# VPN: добавить :compose.vpn.yml
COMPOSE_FILE=docker-compose.yml:compose.nvidia.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROJECT_NAME=home-theater

# --- Система ---
# Linux: `id -u` / `id -g`. Windows: оставить 1000.
PUID=1000
PGID=1000
TZ=Europe/Moscow

# --- Пути ---
# Конфиги сервисов (это то, что бэкапится и переносится)
CONFIG_ROOT=./config
# Медиа и загрузки. ВАЖНО: torrents и media должны быть на одном диске (hardlinks).
# Linux-сервер: например /srv/media. Windows: лучше путь внутри WSL или отдельный диск.
DATA_ROOT=./data

# --- Сеть ---
TORRENT_PORT=6881
# Порт WebUI qBittorrent на хосте (внутри docker-сети всегда 8080)
QBIT_WEBUI_PORT=8090
# Адрес, по которому клиенты видят Jellyfin (необязательно), например http://192.168.1.10:8096
JELLYFIN_PUBLISHED_URL=
LAN_SUBNET=192.168.0.0/16
# MTU docker-сети: не больше MTU VPN-туннеля на хосте (`ip link`), иначе HTTPS из контейнеров виснет.
# Без VPN на хосте можно 1500
DOCKER_MTU=1376
# Первые два октета подсети docker-сети проекта (<DOCKER_NET>.0.0/16). Сменить, если подсеть
# занята другой сетью Docker («Pool overlaps»): например, docker_gwbridge на Windows занял 172.25
DOCKER_NET=172.25

# --- API-ключи (32 hex-символа; init.py сгенерирует) ---
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# --- Учётные записи, которые создаст bootstrap.py ---
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=
SEERR_ADMIN_EMAIL=admin@home.local
QBIT_USER=admin
QBIT_PASSWORD=

# --- Трекеры (пусто = индексатор не добавляется) ---
RUTRACKER_USER=
RUTRACKER_PASSWORD=
KINOZAL_USER=
KINOZAL_PASSWORD=

# --- Аниме-календарь (apps/anime-calendar, http://localhost:5056) ---
# Секрет cookie-сессий и ключ RU-индексатора для Sonarr (init.py сгенерирует)
ANIME_CALENDAR_SECRET=
ANIME_CALENDAR_TORZNAB_KEY=
# Заполняет bootstrap.py (берёт ключ из настроек Seerr)
# Ключ Jellyfin для календаря (создаёт bootstrap.py --only jellyfin)
JELLYFIN_API_KEY=
SEERR_API_KEY=
# Адрес Seerr для ссылок из браузера (на сервере: http://<ip-сервера>:5055)
SEERR_PUBLIC_URL=http://localhost:5055
# Синхронизация списков с Shikimori (необязательно):
#  1) создай приложение: https://shikimori.io/oauth/applications
#     Redirect URI: urn:ietf:wg:oauth:2.0:oob, права (scopes): user_rates
#  2) впиши сюда client id/secret и точное название приложения
SHIKIMORI_URL=https://shikimori.io
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
SHIKIMORI_APP_NAME=

# --- Рекомендации (локальная LLM в Ollama) ---
# RTX с 12–16 ГБ: qwen3.5:9b. Мини-сервер без GPU: qwen3.5:4b (анализ идёт в фоне, медленнее)
LLM_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3
# Откуда bootstrap качает модели (hf.co/<репозиторий>:<квант>, пусто — реестр Ollama).
# По умолчанию для qwen3.5:9b и bge-m3 — HuggingFace (MODEL_SOURCES в bootstrap.py)
# LLM_MODEL_SOURCE=hf.co/unsloth/Qwen3.5-4B-GGUF:Q4_K_M
# EMBED_MODEL_SOURCE=

# --- VPN (только если подключён compose.vpn.yml) ---
VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=
VPN_SERVER_COUNTRIES=

# Intel iGPU (compose.intel.yml): getent group render | cut -d: -f3
RENDER_GID=105

# ИИ-апскейл постеров (контейнер upscaler, Real-ESRGAN). Включить: COMPOSE_PROFILES=upscaler
#   модель: realesr-animevideov3 (быстрая, ×2/×3/×4) или realesrgan-x4plus-anime (качественнее, только ×4)
#   цель — ширина результата, px; масштаб не больше MAX_SCALE; меньше MIN_SRC px не трогаем (выйдет «каша»)
#   TTL_MULT — во сколько раз дольше обычного кэша хранить результат апскейла
COMPOSE_PROFILES=upscaler
IMG_UPSCALE_MODEL=realesr-animevideov3
IMG_UPSCALE_TARGET=1000
IMG_UPSCALE_MAX_SCALE=4
IMG_UPSCALE_MIN_SRC=150
IMG_UPSCALE_TTL_MULT=4
